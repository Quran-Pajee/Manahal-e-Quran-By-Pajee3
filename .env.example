# ---- Site ----
# Your live domain, no trailing slash. Used for canonical URLs, sitemap and schema.
NEXT_PUBLIC_SITE_URL=https://quran.pajee.org

# The WhatsApp number and email are set in src/content/site.ts. Fill these in only to use different ones on this deployment.
# WhatsApp: digits only with country code (example: 923156540714).
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- Admin panel (/admin) and account logins ----
# Choose a long password. The admin panel stays locked until this is set.
ADMIN_PASSWORD=
# Recommended: any long random string. It signs the login cookies. Generate one: openssl rand -hex 32.
# If left empty on the live site, a key is made from the database address instead. Changing it later signs everyone out.
AUTH_SECRET=

# ---- Database (trial requests, accounts, classes, lessons, quizzes) ----
# Neon pooled Postgres connection string (hostname contains -pooler). Paste into Vercel Environment Variables.
# Never commit a real connection string to GitHub.
# Leave empty on your own computer and the site keeps its data in the .data folder instead.
DATABASE_URL=

# ---- New-lead alerts (optional) ----
# Email alert through Resend (resend.com). LEAD_ALERT_FROM must be on a domain you verified in Resend.
RESEND_API_KEY=
LEAD_ALERT_TO=
LEAD_ALERT_FROM=
# Or post every new lead as JSON to a webhook (Zapier, Make, Google Apps Script).
LEAD_WEBHOOK_URL=

# ---- Tracking (optional, loaded only after cookie consent) ----
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# ---- Search engine verification (optional) ----
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Time zone used for dates in the admin dashboard (IANA name).
ADMIN_TIMEZONE=Asia/Karachi

# Optional legacy connection variable supported by db.ts (prefer DATABASE_URL).
# POSTGRES_URL=
